/_manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: no-cache, must-revalidate

/*.js.map
  Cache-Control: no-cache, must-revalidate

/*.*.js
  Cache-Control: public, max-age=31536000, immutable

/*.*.js.map
  Cache-Control: public, max-age=31536000, immutable

/demo/*
  Cache-Control: public, max-age=3600

/demo/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/demo/pricing.html
  Cache-Control: no-cache, no-store, must-revalidate

/demo/app-demo.html
  Cache-Control: no-cache, no-store, must-revalidate

/demo/workflow-demo.html
  Cache-Control: no-cache, no-store, must-revalidate

/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable
